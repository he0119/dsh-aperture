{
  "name": "dsh-aperture",
  "version": "0.3.2",
  "description": "自动发现 Aperture 网关上的模型，并加进 DSH 的模型选择器。",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "tsdown --concurrency 1",
    "build:host": "tsdown --filter dsh-aperture/host && tsdown --filter dsh-aperture/types",
    "build:client": "tsdown --filter dsh-aperture/client",
    "watch": "tsdown --watch --concurrency 1",
    "watch:client": "tsdown --filter dsh-aperture/client --watch",
    "prepare": "node --run prebuild && node --run build",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.client.json",
    "pretest": "node --run build:client",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:live": "node --test test/live.test.ts",
    "inspect": "node scripts/inspect-live.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "aperture",
    "tailscale",
    "llm",
    "model-discovery"
  ],
  "license": "MIT",
  "author": "uy/sun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/he0119/dsh-aperture.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.1.7-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/cosmokit": "1.8.5",
    "@deepseek-ai/dsh-api-gateway": "0.1.7-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.7-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1",
    "@deepseek-ai/dsh-config-editor": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.7-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0"
  }
}
